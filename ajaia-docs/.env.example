# Local development uses a SQLite file by default. No setup needed.
DATABASE_URL=file:data/app.db

# For a hosted deployment, use a free Turso database (libSQL):
# DATABASE_URL=libsql://your-db-name-your-org.turso.io
# DATABASE_AUTH_TOKEN=your-turso-token

# Random string used to sign session cookies. Required in production.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=change-me-in-production
